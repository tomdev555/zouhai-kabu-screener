# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# EDINET長期履歴キャッシュ
/.cache/

# 作業用のSQLite (成果物はpublic/data/*.jsonなので共有不要)
/prisma/*.db
/prisma/*.db-journal

# 自動生成される静的サイト用データ (CIで毎回生成する)
/public/data/
